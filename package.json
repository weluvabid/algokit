{
  "name": "@weluvabid/algokit",
  "version": "0.1.0",
  "type": "module",
  "description": "Algorithms and data structures with traceable execution.",
  "exports": {
    ".": "./dist/index.js",
    "./priority-queue": "./dist/priority-queue/index.js",
    "./graph": "./dist/graph/index.js",
    "./trace": "./dist-trace/trace/index.js",
    "./trace-build/graph": "./dist-trace/graph/index.js",
    "./ordered-tree": "./dist/ordered-tree/index.js",
    "./implicit-treap": "./dist/implicit-treap/index.js",
    "./bloom-filter": "./dist/bloom-filter/index.js",
    "./hyperloglog": "./dist/hyperloglog/index.js",
    "./consistent-hashing": "./dist/consistent-hashing/index.js",
    "./rendezvous-hashing": "./dist/rendezvous-hashing/index.js"
  },
  "files": [
    "dist",
    "dist-trace"
  ],
  "scripts": {
    "build": "tsx tooling/build.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.check.json",
    "test": "NODE_OPTIONS=--conditions=development vitest run",
    "test:watch": "NODE_OPTIONS=--conditions=development vitest",
    "test:coverage": "NODE_OPTIONS=--conditions=development vitest run --coverage",
    "check:package": "tsx tooling/check-package.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck:all && npm run test && npm run build && npm run check:package",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@eslint/js": "^9.39.0",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.18.6",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.0.5"
  },
  "imports": {
    "#graph": {
      "types": "./src/graph/index.ts",
      "development": "./src/graph/index.ts",
      "default": "./dist/graph/index.js"
    },
    "#priority-queue": {
      "types": "./src/priority-queue/index.ts",
      "development": "./src/priority-queue/index.ts",
      "default": "./dist/priority-queue/index.js"
    },
    "#trace": {
      "types": "./src/trace/index.ts",
      "development": "./src/trace/index.ts",
      "default": "./dist-trace/trace/index.js"
    },
    "#trace/*": {
      "types": "./src/trace/*.ts",
      "development": "./src/trace/*.ts",
      "default": "./dist-trace/trace/*.js"
    },
    "#ordered-tree": {
      "types": "./src/ordered-tree/index.ts",
      "development": "./src/ordered-tree/index.ts",
      "default": "./dist/ordered-tree/index.js"
    },
    "#implicit-treap": {
      "types": "./src/implicit-treap/index.ts",
      "development": "./src/implicit-treap/index.ts",
      "default": "./dist/implicit-treap/index.js"
    },
    "#bloom-filter": {
      "types": "./src/bloom-filter/index.ts",
      "development": "./src/bloom-filter/index.ts",
      "default": "./dist/bloom-filter/index.js"
    },
    "#hyperloglog": {
      "types": "./src/hyperloglog/index.ts",
      "development": "./src/hyperloglog/index.ts",
      "default": "./dist/hyperloglog/index.js"
    },
    "#consistent-hashing": {
      "types": "./src/consistent-hashing/index.ts",
      "development": "./src/consistent-hashing/index.ts",
      "default": "./dist/consistent-hashing/index.js"
    },
    "#rendezvous-hashing": {
      "types": "./src/rendezvous-hashing/index.ts",
      "development": "./src/rendezvous-hashing/index.ts",
      "default": "./dist/rendezvous-hashing/index.js"
    }
  }
}
